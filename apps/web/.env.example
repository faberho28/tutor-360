# Server-only variables. Never prefix them with NEXT_PUBLIC_.
# Copy this file to .env.local and fill in the values (.env.local is ignored by git).

# Meta Model API (OpenAI-compatible)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Models
SEGMENTATION_MODEL=sam-3.1
DIAGNOSIS_MODEL=

# Minimum confidence to show a detection (0 to 1). Optional; defaults to 0.85.
SEGMENT_SCORE_THRESHOLD=0.85

# Public (sent to the browser, never put a secret here).
# Minimum time in ms between two analyses. Default 2000, floor 500.
NEXT_PUBLIC_ANALYSIS_MIN_GAP_MS=2000